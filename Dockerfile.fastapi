FROM python:3.12-slim

WORKDIR /app

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH="/app/src:/app/src/api:$PYTHONPATH"

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc python3-dev libpq-dev && \
    rm -rf /var/lib/apt/lists/*

# Use system Python directly to avoid exec format errors

# Copy application code first
COPY src/ ./src/

# Copy dependency files
COPY pyproject.toml ./

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -e .

# Create non-root user with proper shell and home directory
RUN groupadd --system app && \
    useradd --system --gid app --create-home --shell /bin/bash app && \
    chown -R app:app /app && \
    chmod -R 755 /app

USER app

# Set the working directory to the src directory
WORKDIR /app/src

# Command to run the application
CMD ["python", "-m", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]

# Expose the FastAPI port
EXPOSE 8000